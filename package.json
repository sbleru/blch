{
  "name": "blch",
  "version": "1.1.4",
  "description": "BLEACH tldr utility",
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc && cp -r data build/",
    "mkmd": "rm -rf build/pages && cp -r pages build/",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "bin": {
    "blch": "build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbleru/blch.git"
  },
  "keywords": [
    "Git",
    "CLI"
  ],
  "author": "sbleru",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^15.0.0",
    "csvtojson": "^2.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
